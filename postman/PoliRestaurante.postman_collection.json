{
  "info": {
    "name": "PoliRestaurante API",
    "description": "Endpoints del backend (Spring Boot). Ejecuta primero la carpeta Autenticación: inicia sesión con mesero, cocina y admin (contraseña 1234) y guarda un token por rol; cada carpeta envía el suyo en la cabecera Authorization: Bearer. Cambia la variable pedidoId por el id que devuelva 'Crear pedido'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "pedidoId",
      "value": "1"
    },
    {
      "key": "tokenMesero",
      "value": ""
    },
    {
      "key": "tokenCocina",
      "value": ""
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "pedidoCancelarId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "RF-11 Iniciar sesión como mesero",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Guarda el token en la variable tokenMesero.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"mesero\",\n  \"password\": \"1234\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Inicio de sesión correcto', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenMesero', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "RF-11 Iniciar sesión como cocina",
