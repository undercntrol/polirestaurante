              "mode": "raw",
              "raw": "{\n  \"motivo\": \"Se acabó el pan\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cancelado por cocina', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const p = pm.response.json();",
                  "  pm.expect(p.estado).to.eql('CANCELADO');",
                  "  pm.expect(p.canceladoPor).to.eql('COCINA');",
                  "  pm.expect(p.motivoCancelacion).to.eql('Se acabó el pan');",
                  "});"
                ]
              }
            }
          ]
