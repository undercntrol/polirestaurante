{
  "info": {
    "name": "PoliRestaurante API",
    "description": "Endpoints del backend (Spring Boot). Datos de prueba: mesero id 1, cocina id 1. Cambia la variable pedidoId por el id que devuelva 'Crear pedido'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "pedidoId",
      "value": "1"
    },
    {
      "key": "meseroId",
      "value": "1"
    },
    {
      "key": "cocinaId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Consultas",
      "item": [
        {
          "name": "Menú (solo disponibles)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/menu",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Mesas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/mesas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mesas"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Métodos de pago (HU-06)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/metodos-pago",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "metodos-pago"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Mesero",
      "item": [
        {
          "name": "HU-01 Crear pedido en sitio",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mesaId\": 1,\n  \"meseroId\": {{meseroId}},\n  \"tipoPedido\": \"EN_SITIO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "HU-01 Crear pedido para llevar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pedidos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"meseroId\": {{meseroId}},\n  \"tipoPedido\": \"PARA_LLEVAR\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Ver pedido",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pedidos/{{pedidoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos",
                "{{pedidoId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "HU-02 Agregar producto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pedidos/{{pedidoId}}/detalles",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos",
                "{{pedidoId}}",
                "detalles"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": 1,\n  \"cantidad\": 2,\n  \"notas\": \"sin cebolla\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "HU-02 Quitar línea",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pedidos/{{pedidoId}}/detalles/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos",
                "{{pedidoId}}",
                "detalles",
                "1"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "HU-05 Marcar entregado",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pedidos/{{pedidoId}}/entregar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos",
                "{{pedidoId}}",
                "entregar"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"meseroId\": {{meseroId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "HU-06 Registrar pago",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pedidos/{{pedidoId}}/pago",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos",
                "{{pedidoId}}",
                "pago"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"metodoPagoId\": 1,\n  \"meseroId\": {{meseroId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "HU-07 Cancelar pedido",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/pedidos/{{pedidoId}}/cancelar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos",
                "{{pedidoId}}",
                "cancelar"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"meseroId\": {{meseroId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "HU-08 Mis pedidos activos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pedidos/activos?meseroId={{meseroId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos",
                "activos"
              ],
              "query": [
                {
                  "key": "meseroId",
                  "value": "{{meseroId}}"
                }
              ]
            },
            "description": ""
          }
        },
        {
          "name": "HU-10 Historial de estados",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/pedidos/{{pedidoId}}/historial",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "pedidos",
                "{{pedidoId}}",
                "historial"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "Cocina",
      "item": [
